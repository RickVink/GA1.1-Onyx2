   "source": [
    "def add(a, b):\n",
    "    sum = a+b\n",
    "\n",
    "    return sum\n",
    "\n",
    "c = add(1,4)\n",
    "d = add(5,4)\n",
    "e = add(3,4)\n",
    "\n",
    "print(c, d, e)"
   ]
  },
  {
   "cell_type": "code",
